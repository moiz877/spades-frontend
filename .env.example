# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (used by scripts/ingest.py and the Next.js API routes)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=energy_explorer

# EIA API v2 key — https://www.eia.gov/opendata/register.php
# Server-side only. Never exposed to the client.
EIA_API_KEY=

# Phase 2 — lead-gen / TEA report export
# Long random string, independent from EIA_API_KEY.
LEAD_TOKEN_SECRET=
# URL of the deployed pdf-service (Railway/Render) — public, safe for the client.
NEXT_PUBLIC_PDF_SERVICE_URL=http://localhost:8001

# Phase 5 — lead alerts, booking, SEO, admin
# Resend (https://resend.com) API key for the lead-capture email alert.
# Free tier's sandbox sender (onboarding@resend.dev) can send to the
# account owner's own verified email without a custom domain.
RESEND_API_KEY=
LEAD_ALERT_EMAIL=khanmuhammadabdulmoiz@gmail.com
LEAD_ALERT_FROM=onboarding@resend.dev

# Public booking link (Cal.com, Calendly, ...). The "Book a call" button
# renders nothing if this is unset.
NEXT_PUBLIC_BOOKING_URL=

# Canonical site URL, used for sitemap.xml, robots.txt, and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared password gating /admin (lead list + CSV export). Solo-operator
# auth only — not per-user, no audit log. Pick a long random value.
ADMIN_PASSWORD=

# Phase 6 — company registration / team accounts (NextAuth.js)
# Long random string used to sign session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
NEXTAUTH_SECRET=
# Must match the URL NextAuth is actually served from.
NEXTAUTH_URL=http://localhost:3000
