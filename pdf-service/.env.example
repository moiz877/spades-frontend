# Copy this file to .env and fill in real values. Never commit .env.

# Same MongoDB cluster as the Next.js app — reads/writes the `leads` collection.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=energy_explorer

# MUST exactly match LEAD_TOKEN_SECRET in the Next.js app's .env — this is
# what verifies tokens that /api/leads issued.
LEAD_TOKEN_SECRET=

# Comma-separated list of origins allowed to call this service from a
# browser (your deployed frontend URL). "*" is fine for local dev only.
ALLOWED_ORIGINS=http://localhost:3000
